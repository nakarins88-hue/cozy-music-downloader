{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/**/*",
    "src/shared/**/*",
    "tests/renderer/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"],
      "@components/*": ["src/renderer/src/components/*"],
      "@hooks/*": ["src/renderer/src/hooks/*"],
      "@store/*": ["src/renderer/src/store/*"],
      "@pages/*": ["src/renderer/src/pages/*"]
    }
  }
}
